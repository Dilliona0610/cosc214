class Solution {
    public int search(int[] nums, int target) {
        int low = 0;
        int high = nums.length - 1;

        while (low <= high) {
            // Safe mid calculation to prevent potential integer overflow
            int mid = low + (high - low) / 2;

            if (target == nums[mid]) {
                return mid;
            }
            // Target is greater than mid value, so search the right half
            else if (target > nums[mid]) {
                low = mid + 1;
            }
            // Target is smaller than mid value, so search the left half
            else {
                high = mid - 1;
            }
        }

        // Target doesn't exist in the array
        return -1;
    }
}
